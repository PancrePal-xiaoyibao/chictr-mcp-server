{
  "name": "chictr-mcp-server",
  "version": "3.0.0",
  "description": "MCP Server for querying ChiCTR clinical trials",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "chictr-mcp-server": "./dist/index.js",
    "chictr-setup": "./dist/cli/setup-cli.js"
  },
  "files": [
    "dist",
    "sidecar",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "test": "npx tsc -p tsconfig.test.json && node --test dist-test/**/*.test.js",
    "prepare": "npm run build",
    "prepack": "node scripts/prune-tests.mjs",
    "doctor": "node dist/cli/setup-cli.js doctor",
    "setup": "node dist/cli/setup-cli.js setup",
    "sidecar": "node dist/cli/setup-cli.js sidecar",
    "postinstall": "node dist/cli/setup-cli.js postinstall",
    "cli": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "clinical-trials",
    "chictr",
    "medical-research"
  ],
  "author": "ChiCTR MCP Server Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PancrePal-xiaoyibao/chictr-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/PancrePal-xiaoyibao/chictr-mcp-server/issues"
  },
  "homepage": "https://github.com/PancrePal-xiaoyibao/chictr-mcp-server#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.1.2",
    "node-cache": "^5.1.2",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6"
  }
}
